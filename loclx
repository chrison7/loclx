def is_number(value: Any) -> bool:
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)


def haversine_m(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
    radius = 6371000.0
    p1 = math.radians(lat1)
    p2 = math.radians(lat2)
    dphi = math.radians(lat2 - lat1)
    dlmb = math.radians(lon2 - lon1)
    a = math.sin(dphi / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dlmb / 2) ** 2
    return 2 * radius * math.atan2(math.sqrt(a), math.sqrt(1 - a))


def format_distance(meters: float) -> str:
    if meters < 1000:
        if meters < 10:
            return f"{meters:.1f} m"
        return f"{meters:.0f} m"
    return f"{meters / 1000.0:.1f} km"


def format_uptime(seconds: float) -> str:
    total = int(seconds)
    h, rem = divmod(total, 3600)
    m, s = divmod(rem, 60)
    if h:
        return f"{h}h {m}m {s}s"
    if m:
        return f"{m}m {s}s"
    return f"{s}s"


def ip_coords(ip_obj: Any) -> Optional[tuple]:
    if not isinstance(ip_obj, dict):
        return None
    lat, lon = ip_obj.get("lat"), ip_obj.get("lon")
    if is_number(lat) and is_number(lon):
        return float(lat), float(lon)
    return None


def delta_m_now() -> Optional[float]:
    ip = lab.get("ip")
    gps = lab.get("gps")
    pair = ip_coords(ip)
    if not pair or not isinstance(gps, dict):
        return None
    if not (is_number(gps.get("lat")) and is_number(gps.get("lon"))):
        return None
    return haversine_m(pair[0], pair[1], float(gps["lat"]), float(gps["lon"]))


def snapshot() -> dict[str, Any]:
    with state_lock:
        delta = delta_m_now()
        return {
            "ip": lab["ip"],
            "gps": lab["gps"],
            "gps_at": lab["gps_at"],
            "updates": lab["updates"],
            "uptime": time.time() - lab["started"],
            "delta_m": delta,
        }


def fmt_accuracy(acc: Any) -> str:
    if not is_number(acc):
        return "n/a"
    value = float(acc)
    if value == int(value):
        return f"±{int(value)} m"
    return f"±{value:.1f} m"


def fmt_altitude(alt: Any) -> str:
    if not is_number(alt):
        return "n/a"
    value = float(alt)
    if value == int(value):
        return f"{int(value)} m"
    return f"{value:.1f} m"


def gps_box_lines(gps: dict[str, Any], when: Optional[str]) -> list[str]:
    lat = gps.get("lat")
    lon = gps.get("lon")
    lat_s = f"{float(lat):.6f}" if is_number(lat) else "n/a"
    lon_s = f"{float(lon):.6f}" if is_number(lon) else "n/a"
    rows = [
        ("latitude", lat_s),
        ("longitude", lon_s),
        ("accuracy", fmt_accuracy(gps.get("accuracy"))),
        ("altitude", fmt_altitude(gps.get("altitude"))),
        ("time", when or "n/a"),
    ]
    inner = 41
    title = " GPS FIX "
    top_fill = inner - 1 - len(title)
    top = "╭─" + title + ("─" * max(0, top_fill)) + "╮"
    bottom = "╰" + ("─" * inner) + "╯"
    lines = [top]
    for key, val in rows:
        body = f" {key:<10}{val}"
        body = body[:inner].ljust(inner)
        lines.append("│" + body + "│")
    lines.append(bottom)
    return lines


def emit(*parts: str, end: str = "\n") -> None:
    text = "".join(parts) + end
    with print_lock:
        try:
            sys.stdout.write(text)
        except UnicodeEncodeError:
            sys.stdout.write(text.encode("utf-8", "replace").decode("ascii", "replace"))
        sys.stdout.flush()


def print_gps_readout(include_meta: bool = False) -> None:
    snap = snapshot()
    gps = snap["gps"]
    if not gps:
        emit(C.amber("permission not granted yet"))
        if include_meta:
            emit(C.dim(f"uptime    {format_uptime(snap['uptime'])}"))
            emit(C.dim(f"fixes     {snap['updates']}"))
        return
    for line in gps_box_lines(gps, snap["gps_at"]):
        emit(C.green(line))
    delta = snap["delta_m"]
    if delta is not None:
        emit(
            C.cyan(
                f"IP geolocation was off by {format_distance(delta)} from this fix."
            )
        )
    emit(C.dim("(kept in memory only, never written to disk)"))
    if include_meta:
        emit(C.dim(f"uptime    {format_uptime(snap['uptime'])}"))
        emit(C.dim(f"fixes     {snap['updates']}"))


def store_report(payload: dict[str, Any]) -> None:
    gps = payload.get("gps")
    ip = payload.get("ip")
    if not isinstance(gps, dict):
        raise ValueError("gps object required")
    if not is_number(gps.get("lat")) or not is_number(gps.get("lon")):
        raise ValueError("lat/lon must be numbers")
    stored_gps = {
        "lat": float(gps["lat"]),
        "lon": float(gps["lon"]),
        "accuracy": float(gps["accuracy"]) if is_number(gps.get("accuracy")) else None,
        "altitude": float(gps["altitude"]) if is_number(gps.get("altitude")) else None,
    }
    stored_ip = None
    if isinstance(ip, dict):
        stored_ip = {
            "ip": ip.get("ip"),
            "city": ip.get("city"),
            "region": ip.get("region"),
            "country": ip.get("country"),
            "isp": ip.get("isp"),
            "lat": float(ip["lat"]) if is_number(ip.get("lat")) else None,
            "lon": float(ip["lon"]) if is_number(ip.get("lon")) else None,
        }
    when = datetime.now().strftime("%H:%M:%S")
    with state_lock:
        lab["gps"] = stored_gps
        lab["gps_at"] = when
        lab["updates"] = int(lab["updates"]) + 1
        if stored_ip is not None:
            lab["ip"] = stored_ip
    emit("\n")
    print_gps_readout(include_meta=False)
    emit("")


