#!/usr/bin/env python3
"""LOCLX — Live Location & Information eXtractor CLI Launcher."""

from __future__ import annotations

import os
import sys

# Ensure src directory is in Python path for loclx package imports
_src_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), "src"))
if _src_dir not in sys.path:
    sys.path.insert(0, _src_dir)

VERSION = "2.1.2"
BIND_ADDR = "127.0.0.1"

# Load HTML_PAGE for backwards compatibility with tests
_web_index = os.path.join(os.path.dirname(__file__), "web", "index.html")
_web_app = os.path.join(os.path.dirname(__file__), "web", "app.js")
if os.path.isfile(_web_index):
    with open(_web_index, "r", encoding="utf-8") as _f:
        HTML_PAGE = _f.read()
    if os.path.isfile(_web_app):
        with open(_web_app, "r", encoding="utf-8") as _af:
            HTML_PAGE += "\n<script>\n" + _af.read() + "\n</script>\n"
else:
    HTML_PAGE = ""

from loclx.cli import main, parse_args  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
